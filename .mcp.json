{
    "mcpServers": {
        "excalidraw": {
            "type": "http",
            "url": "https://api.excalidraw.com/api/v1/mcp",
            "headers": {
                "Authorization": "Bearer ${EXCALIDRAW_TOKEN}"
            }
        },
        "opentofu": {
            "command": "npx",
            "args": [
                "-y",
                "@opentofu/opentofu-mcp-server"
            ]
        },
        "aws-mcp": {
            "command": "uvx",
            "args": [
                "mcp-proxy-for-aws@latest",
                "https://aws-mcp.us-east-1.api.aws/mcp",
                "--metadata",
                "AWS_REGION=us-east-1"
            ]
        }
    }
}